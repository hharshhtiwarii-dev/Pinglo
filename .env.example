# ==============================================================================
# Pinglo — settings template
# ==============================================================================
# Copy this file to `.env` and fill in YOUR OWN values:
#
#     cp .env.example .env
#
# NEVER commit your real `.env` to git. It holds private keys.
# Every value below is a placeholder — replace it with your own value.
# Full setup steps: docs/SETUP.md
# ==============================================================================

# --- AWS region ---------------------------------------------------------------
# The AWS region for all services below.
# Example: ap-southeast-2 (Sydney), ap-south-1 (Mumbai), us-east-1 (N. Virginia)
VITE_AWS_REGION=YOUR_AWS_REGION

# --- AWS Cognito User Pool (sign up / log in) --------------------------------
# AWS Console > Cognito > User Pools > your pool.
# User Pool ID looks like: <region>_<random characters>
VITE_AWS_USER_POOL_ID=YOUR_USER_POOL_ID

# App client ID. Console > Cognito > your pool > App integration > App clients.
# Use a public client with NO client secret (web apps must not have a secret).
VITE_AWS_USER_POOL_CLIENT_ID=YOUR_USER_POOL_CLIENT_ID

# --- AWS Cognito Identity Pool (optional) -------------------------------------
# Console > Cognito > Identity Pools. Used for direct access to S3.
# Leave empty if you do not use it.
VITE_AWS_IDENTITY_POOL_ID=YOUR_IDENTITY_POOL_ID

# --- AWS S3 bucket (photos, videos, voice notes, documents) -------------------
# Console > S3 > Buckets > your bucket. Just the bucket name, not a URL.
VITE_AWS_S3_BUCKET=YOUR_S3_BUCKET_NAME

# --- AWS AppSync (chat data and real-time sync) -------------------------------
# Console > AppSync > your API > Settings. The endpoint is an https:// URL.
VITE_AWS_APPSYNC_ENDPOINT=YOUR_APPSYNC_ENDPOINT_URL

# Console > AppSync > your API > Settings > API key.
VITE_AWS_APPSYNC_API_KEY=YOUR_APPSYNC_API_KEY

# --- Google Gemini API key (Dev AI assistant, optional) -----------------------
# Get a free key at https://aistudio.google.com/apikey
# The app reads VITE_GEMINI_API_KEY first, then GEMINI_API_KEY.
# Leave both empty if you do not want the Dev AI feature.
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# --- Dev AI fallback providers (ALL optional) ---------------------------------
# These are only used if you add a key. Without a key, Dev AI skips them.
# NVIDIA NIM (free tier, no card): https://build.nvidia.com
# VITE_NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY
# Groq (free tier): https://console.groq.com/keys
# VITE_GROQ_API_KEY=YOUR_GROQ_API_KEY
# OpenRouter (":free" models): https://openrouter.ai/keys
# VITE_OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
# Photo generation needs NO key (Pollinations, free).

# --- Giphy API key (GIFs, optional) -------------------------------------------
# Get a free key at https://developers.giphy.com
# Without a key, GIF search is turned off. Stickers and emoji still work.
# VITE_GIPHY_API_KEY=YOUR_GIPHY_API_KEY

# --- TURN server (voice/video calls, optional) ----------------------------
# Your own TURN/STUN server URL (the deployer's own server, e.g. stun:your-server:3478).
# Without it, calls have no STUN server configured. Leave commented out if you do not run one.
# VITE_TURN_SERVER_URL=YOUR_TURN_SERVER_URL

# --- Admin access (optional) --------------------------------------------------
# Comma-separated list of admin email addresses (e.g. admin@example.com,other@example.com).
# Admin screens are only accessible to these addresses. Empty or unset means no admin users.
# VITE_ADMIN_EMAILS=
